# Postgres
DATABASE_URL=postgres://crc:crc@localhost:5433/crc
POSTGRES_PASSWORD=crc
# Session signing secret: generate with `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string
# Where uploaded photos/videos/certificates are stored
MEDIA_DIR=./data/media
# First admin (created by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME="Club Admin"
# Public hostname for Caddy (production)
APP_DOMAIN=localhost
# Public URL used in QR codes / invite links (optional; defaults to the host the request came in on)
APP_URL=
